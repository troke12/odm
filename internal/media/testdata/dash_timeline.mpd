<?xml version="1.0"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT20S">
  <Period duration="PT20S">
    <AdaptationSet contentType="video" mimeType="video/webm">
      <BaseURL>https://cdn.example.org/v/</BaseURL>
      <SegmentTemplate media="t-$Time$.webm" initialization="init.webm" timescale="90000" startNumber="0">
        <SegmentTimeline>
          <S t="0" d="360000" r="2"/>
          <S d="180000"/>
          <S d="90000" r="-1"/>
        </SegmentTimeline>
      </SegmentTemplate>
      <Representation id="vp9" bandwidth="1000000" codecs="vp9"/>
    </AdaptationSet>
  </Period>
</MPD>
